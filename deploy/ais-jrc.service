[Unit]
Description=AIS JRC serial reader and MQTT publisher
Wants=network-online.target
After=network-online.target mosquitto.service
Requires=mosquitto.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=ais-jrc
Group=ais-jrc
SupplementaryGroups=dialout
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/ais-jrc/ais.env
ExecStart="@APP_DIR@/.venv/bin/python" "@APP_DIR@/decode.py" --port /dev/ais --baudrate 38400
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
